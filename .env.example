# Copier vers .env et ajuster si besoin. Aucune valeur ci-dessous n'est un secret réel.

# Base vectorielle (docker compose expose Chroma sur 8002)
CHROMA_URL=http://localhost:8002

# Base SQL Sorabel (SQLite, générée par `make seed`)
SORABEL_DB=data/sorabel.db

# Journal des appels de la gateway
GATEWAY_JOURNAL=logs/mcp_audit.jsonl

# Profil client par défaut du serveur MCP (support | commercial)
SORABEL_PROFILE=support

# Serveur MCP HTTP + IdP Keycloak (mcp_server/http_server.py, déploiement Docker)
KEYCLOAK_ISSUER=http://localhost:8180/realms/sorabel
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# docker-compose uniquement (substitution ${...} dans docker-compose.yml, pas lu par
# l'appli elle-même) : adresse à laquelle Keycloak et la gateway sont *réellement*
# joignables depuis l'extérieur. En local, ne rien changer (défaut "localhost"). Pour
# déployer sur un serveur avec une IP publique ou un nom de domaine, remplacer ici —
# KEYCLOAK_ISSUER ci-dessus est alors ignoré, recalculé automatiquement à partir de
# ces deux variables dans docker-compose.yml.
# PUBLIC_HOSTNAME=mon-serveur.example.com
# KEYCLOAK_PORT=8180

# Mots de passe des deux comptes de démo Keycloak (royaume "sorabel") — générés par
# `uv run python scripts/generate_keycloak_passwords.py`, jamais commités en clair
# (docker/keycloak/sorabel-realm.json.template ne contient que des placeholders,
# substitués au démarrage du conteneur keycloak).
KEYCLOAK_COMMERCIAL_PASSWORD=changeme   # compte "commercial-demo" (rôle commercial)
KEYCLOAK_SUPPORT_PASSWORD=changeme      # compte "support-demo" (rôle support)

# LLM (Azure AI Foundry, endpoint compatible OpenAI /openai/v1)
AZURE_AI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_AI_API_KEY=changeme
AZURE_MODEL_TEXT_EMBEDDING_SMALL=text-embedding-3-small
AZURE_MODEL_RERANKING=Cohere-rerank-v4.0-pro
AZURE_MODEL_TEXT_GENERATION=gpt-5.4-mini

# Observabilité LLM (Langfuse Cloud, scripts/eval_sql.py uniquement pour l'instant)
LANGFUSE_PUBLIC_KEY=pk-lf-changeme
LANGFUSE_SECRET_KEY=sk-lf-changeme
LANGFUSE_BASE_URL=https://cloud.langfuse.com


