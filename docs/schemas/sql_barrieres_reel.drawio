<mxfile host="Electron">
  <diagram name="Text-to-SQL - conception vs reel" id="sql_barrieres_reel_v1">
    <mxGraphModel dx="1178" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="title" parent="1" style="text;html=0;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" value="TEXT-TO-SQL — BARRIERES DE LECTURE SEULE : CONCEPTION vs REEL (verifie le 03/09/2026)" vertex="1"><mxGeometry x="40" y="0" width="1420" height="36" as="geometry"/></mxCell>

<mxCell id="h_concept" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fillColor=#607d8b;strokeColor=#37474f;fontColor=#ffffff;spacing=6;" value="CONCEPTION (attendu)" vertex="1"><mxGeometry x="40" y="100" width="440" height="40" as="geometry"/></mxCell>
<mxCell id="h_reel" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fillColor=#b85450;strokeColor=#7f2f2c;fontColor=#ffffff;spacing=6;" value="REEL VERIFIE" vertex="1"><mxGeometry x="520" y="100" width="440" height="40" as="geometry"/></mxCell>
<mxCell id="h_fix" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fillColor=#82b366;strokeColor=#5a8148;fontColor=#ffffff;spacing=6;" value="CORRECTIF RETENU" vertex="1"><mxGeometry x="1000" y="100" width="420" height="40" as="geometry"/></mxCell>

<!-- Row 1 : fuite sqlite_master -->
<mxCell id="c1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#000000;spacing=6;" value="DENY sur les colonnes sensibles&#xa;(produits.prix_achat_ht, marge_pct,&#xa;ventes.marge_ht) suffit a les&#xa;cacher au profil support" vertex="1"><mxGeometry x="40" y="170" width="440" height="140" as="geometry"/></mxCell>
<mxCell id="r1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontSize=12;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;spacing=6;" value="SELECT name, sql FROM sqlite_master&#xa;retourne le CREATE TABLE complet —&#xa;colonnes sensibles revelees malgre&#xa;leur filtrage. L&#x27;authorizer ne&#xa;protege pas nativement les tables&#xa;internes de SQLite" vertex="1"><mxGeometry x="520" y="170" width="440" height="140" as="geometry"/></mxCell>
<mxCell id="x1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontSize=12;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;spacing=6;" value="DENY sur toute lecture de table&#xa;dont le nom commence par&#xa;&quot;sqlite_&quot;" vertex="1"><mxGeometry x="1000" y="170" width="420" height="140" as="geometry"/></mxCell>

<!-- Row 2 : liste noire insuffisante -->
<mxCell id="c2" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#000000;spacing=6;" value="Un authorizer qui refuse les&#xa;colonnes sensibles protege&#xa;la lecture seule" vertex="1"><mxGeometry x="40" y="340" width="440" height="140" as="geometry"/></mxCell>
<mxCell id="r2" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontSize=12;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;spacing=6;" value="Un tel authorizer laisse passer&#xa;un UPDATE — il ne reagissait&#xa;qu&#x27;a SQLITE_READ, jamais teste&#xa;sur SQLITE_UPDATE / TRANSACTION" vertex="1"><mxGeometry x="520" y="340" width="440" height="140" as="geometry"/></mxCell>
<mxCell id="x2" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontSize=12;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;spacing=6;" value="Allowlist stricte, deny par&#xa;defaut : seuls SQLITE_SELECT +&#xa;SQLITE_READ + SQLITE_FUNCTION&#xa;autorises (10 formes de requetes&#xa;legitimes instrumentees)" vertex="1"><mxGeometry x="1000" y="340" width="420" height="140" as="geometry"/></mxCell>

<!-- Row 3 : PRAGMA incompatible -->
<mxCell id="c3" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#000000;spacing=6;" value="get_schema() introspecte via&#xa;PRAGMA table_info / foreign_key_list&#xa;— une seule connexion suffit&#xa;pour tout" vertex="1"><mxGeometry x="40" y="510" width="440" height="140" as="geometry"/></mxCell>
<mxCell id="r3" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontSize=12;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;spacing=6;" value="PRAGMA declenche SQLITE_PRAGMA,&#xa;absent de l&#x27;allowlist stricte —&#xa;refuse par l&#x27;authorizer&#xa;d&#x27;execution" vertex="1"><mxGeometry x="520" y="510" width="440" height="140" as="geometry"/></mxCell>
<mxCell id="x3" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontSize=12;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;spacing=6;" value="Deux connexions separees :&#xa;introspection (sans authorizer,&#xa;PRAGMA ecrits par notre code)&#xa;+ execution (authorizer strict,&#xa;SQL genere ou fige)" vertex="1"><mxGeometry x="1000" y="510" width="420" height="140" as="geometry"/></mxCell>

<!-- Row 4 : mois sans annee -->
<mxCell id="c4" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#000000;spacing=6;" value="Donner la plage de dates globale&#xa;(&quot;commandes du 2025-09-04&#xa;au 2026-08-19&quot;) suffit a deduire&#xa;l&#x27;annee d&#x27;un mois cite seul" vertex="1"><mxGeometry x="40" y="680" width="440" height="140" as="geometry"/></mxCell>
<mxCell id="r4" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontSize=12;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;spacing=6;" value="Declenche une fausse ambiguite —&#xa;&quot;quel avril ?&quot; alors qu&#x27;un&#xa;seul avril existe. Sans contexte :&#xa;parfois devine, parfois refuse&#xa;(comportement instable)" vertex="1"><mxGeometry x="520" y="680" width="440" height="140" as="geometry"/></mxCell>
<mxCell id="x4" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontSize=12;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;spacing=6;" value="Le code calcule le millesime de&#xa;chaque mois par introspection des&#xa;donnees, injecte comme un fait :&#xa;&quot;avril -&gt; 2026&quot;,&#xa;&quot;octobre -&gt; 2025&quot;" vertex="1"><mxGeometry x="1000" y="680" width="420" height="140" as="geometry"/></mxCell>

